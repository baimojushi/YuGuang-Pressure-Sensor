# 本地 PDF 预览：OSS 未对 localhost 配 CORS 时，走 Vite 代理同源拉取（仅 dev 生效，见 vite.config server.proxy）
VITE_DEV_PDF_OSS_ORIGIN=https://qsedupro-oss.qsban.cn
VITE_DEV_PDF_OSS_PROXY=/dev-proxy-pdf-oss
# 本地 dev 代理 IoT 接口域名（该域名未配置 CORS），见 vite.config server.proxy
VITE_DEV_IOT_API_PROXY=/dev-proxy-iot

VITE_APP_BASE_API ="https://api-dev.ljyd.cn/agent-merchant"
VITE_APP_H5_API ="https://api-dev.ljyd.cn"
VITE_APP_XJIANG_API ="https://xjcloud-open-dev.xjiangiot.com/ProductPublish"
VITE_APP_VOICE_PID="11879"
VITE_APP_IOT_API="https://cn-north-1-dev-testcloudserver.xjiangiot.com"
VITE_APP_DEFAULT_LANGUAGE="zh"
VITE_APP_PRODUCT_API ="https://xjcloud-open-dev.xjiangiot.com/ProductFunction"
VITE_APP_PLATFORM_BASE="https://platform-dev.ljyd.cn"

VITE_YG_ENABLE_SIID19=true
VITE_YG_ENABLE_SIID19_LIGHT_PREVIEW=false
