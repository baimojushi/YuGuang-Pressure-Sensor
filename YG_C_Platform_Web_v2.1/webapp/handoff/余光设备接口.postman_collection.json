{
  "info": {
    "name": "余光设备接口 v2 · 尚未适配灵机平台",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "余光业务接口请求模板。不是灵机官方API、不是固件、也不表示真机接入。有效调用会改变所绑定用户的数据。先在本地测试账号和设备使用；正式环境仅由设备主人授权测试。不要导出带真实key的环境文件。硬件呼吸采集请按docs/硬件API.md上传真实数据，本集合不生成采样。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3100/api"
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "deviceKey",
      "value": "",
      "type": "secret"
    },
    {
      "key": "commandId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "audioId",
      "value": ""
    },
    {
      "key": "measuredAt",
      "value": ""
    },
    {
      "key": "rpm",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 心跳（会更新在线状态）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/heartbeat",
        "description": "有效密钥会使设备显示在线。PC 调用只证明协议接通，不是真机在线验收。约每10秒一次。",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 查询待传达（可能分配指令）",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/pending",
        "description": "约每2秒一次；command.id复制到commandId变量。command=null可能是无队列、专注、休息、离线或冷却，不要判成错误。"
      }
    },
    {
      "name": "03 设备接受灯效",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/delivered",
        "description": "设备接受指令后调用；按响应playUntil执行一轮。不能当作用户已读。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"commandId\": \"{{commandId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 短触主动回应",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/gesture",
        "description": "必须有真实短触再上报。重试同一个eventId，新物理动作换新eventId；休息到时优先确认休息。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"short_touch\",\n  \"eventId\": \"{{eventId}}\",\n  \"commandId\": \"{{commandId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 长触开始休息",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/gesture",
        "description": "只在真实长触>=5秒时调用；与短触互斥，不能用同一eventId切换类型。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"long_touch\",\n  \"durationMs\": 5000,\n  \"eventId\": \"{{eventId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 开启专注",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/focus",
        "description": "真实修改设备主人专注状态。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"focus\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 退出专注",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/focus",
        "description": "退出后仍需遵守队列冷却时间。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"focus\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 主动查询留言",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/messages",
        "description": "只在本人要求回听时查询，选择相应audioUrl，不能自动播放亲友原声。"
      }
    },
    {
      "name": "09 主动回听音频",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/audio/{{audioId}}",
        "description": "本人主动请求后读取二进制，设备密钥鉴权；保留实际Content-Type，不假定为PCM。"
      }
    },
    {
      "name": "10 桌搭持续呼吸结果（真实结果才提交）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Device-Key",
            "value": "{{deviceKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/hardware/{{deviceId}}/breathing/live",
        "description": "measuredAt填写当前设备采样UTC毫秒；rpm填写真实算法结果；eventId填写新事件编号。无信号时status改no_signal并删除rpm。每1–2秒上报，最多1次/秒。旧离线数据使用breathing分段接口。此请求为余光接口，不代表灵机平台链路已接通。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"measuredAt\": {{measuredAt}},\n  \"status\": \"tracking\",\n  \"rpm\": {{rpm}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
