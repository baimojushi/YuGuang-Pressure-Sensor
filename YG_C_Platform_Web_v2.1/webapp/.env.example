# 未配置 Supabase 时本地默认使用 SQLite；可选配置如下。
PORT=3100
DATA_DIR=./data-v2
# 设备密钥由主人绑定设备时生成，只显示一次；不要写入前端或 Git。
# 正式版选择 Supabase 时取消下面注释；展示版仍使用本地 SQLite。
# LIVE_STORAGE=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET
# SUPABASE_AUDIO_BUCKET=yuguang-audio
# 仅执行旧迁移脚本不会切库；当前结构使用 202610300001_live_v2.sql。
# 如当前网络必须经代理访问云数据库，可配置以下进程级选项（需要 Node >=24.5）。
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# V2.1: independent random secret (at least 32 characters) for your VERIFIED Lingji callback adapter -> Web App hop.
# CARE_ACK_BRIDGE_SECRET=replace-with-64-random-characters
# CARE_DISPLAY_BRIDGE_SECRET=another-dedicated-64-character-random-secret

# Private voice-read bridge: 32+ random characters. The vendor adapter must authenticate device identity before signing.
# VOICE_READ_BRIDGE_SECRET=replace-with-independent-64-character-random-secret
# Optional private HTTPS model: classify sender note to {"intent":"miss|meal|rest|cheer"}.
# LIGHT_MAPPER_URL=https://your-private-model.example.com/classify
# LIGHT_MAPPER_TOKEN=server-side-only-bearer-token
