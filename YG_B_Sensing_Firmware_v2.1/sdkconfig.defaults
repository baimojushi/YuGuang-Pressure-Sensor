CONFIG_IDF_TARGET="esp32s3"
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_SMP_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_FREERTOS_HZ=1000

# 16 MB flash + 自定义分区表：为 coco_pose 模型腾出 3200K
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB OCT PSRAM：esp-dl 张量与摄像头帧缓冲都放外部 RAM（与 A 板同参）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# YOLO11n-pose 模型烧进 coco_pose 分区（V1 与 A 板一致）
# 注意：V2 的 FLASH 开关在 Kconfig 里 default y，必须显式关掉，
# 否则 V1+V2 两个模型都会被打包（3.10MB + 3.12MB = 6.22MB），超出 3200K 分区。
CONFIG_FLASH_COCO_POSE_YOLO11N_POSE_S8_V1=y
# CONFIG_FLASH_COCO_POSE_YOLO11N_POSE_S8_V2 is not set
CONFIG_COCO_POSE_YOLO11N_POSE_S8_V1=y
CONFIG_COCO_POSE_MODEL_IN_FLASH_PARTITION=y

# BF3901 走 esp_video 的 SPI 视频设备；不开这些开关时
# esp_video_init_config_t 连 .spi 成员都不存在，bsp_camera.c 无法编译。
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_DATA_PREPROCESSING=y
CONFIG_ESP_VIDEO_CHECK_PARAMETERS=y
CONFIG_CAMERA_BF3901=y
CONFIG_CAMERA_BF3901_AUTO_DETECT_SPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_BF3901_SPI_YUV422_240X320_12FPS=y
CONFIG_CAMERA_BF3901_SPI_DEFAULT_FMT_YUV422_240X320_12FPS=y
CONFIG_CAMERA_BF3901_SPI_IF_FORMAT_INDEX_DEFAULT=2
CONFIG_CAMERA_SENSOR_XCLK_INPUT_24M=y
CONFIG_CAMERA_XCLK_USE_LEDC=y

CONFIG_BT_BTC_TASK_STACK_SIZE=6144
CONFIG_BT_BTU_TASK_STACK_SIZE=6144
